<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.springblade.modules.social.mapper.TagMapper">

	<select id="selectTagsNums" resultType="org.springblade.modules.tag.pojo.entity.TagEntity">
		SELECT * FROM t_tag ORDER BY count DESC LIMIT 0,#{nums}
	</select>

</mapper>

