<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.springblade.modules.couponreceivelog.mapper.CouponReceiveLogMapper">

    <select id="selectCouponReceiveLogPage" resultType="org.springblade.modules.couponreceivelog.pojo.vo.CouponReceiveLogVO">
        select * from coupon_receive_log where is_deleted = 0
    </select>

    <select id="exportCouponReceiveLog" resultType="org.springblade.modules.couponreceivelog.excel.CouponReceiveLogExcel">
        select * from coupon_receive_log
    </select>

</mapper>
