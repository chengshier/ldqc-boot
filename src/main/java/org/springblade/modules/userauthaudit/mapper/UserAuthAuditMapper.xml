    <select id="selectUserAuthAuditPage" resultMap="userAuthAuditResultMap">
        select * from ldqc_user_auth_audit where is_deleted = 0
    </select>


    <select id="exportUserAuthAudit" resultType="org.springblade.modules.userauthaudit.excel.UserAuthAuditExcel">
        SELECT * FROM ldqc_user_auth_audit ${ew.customSqlSegment}
    </select>

</mapper>
