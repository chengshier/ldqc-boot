<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.springblade.modules.sportinvitemedia.mapper.SportInviteMediaMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="sportInviteMediaResultMap" type="org.springblade.modules.sportinvitemedia.pojo.entity.SportInviteMediaEntity">
        <result column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="status" property="status"/>
        <result column="create_user" property="createUser"/>
        <result column="create_dept" property="createDept"/>
        <result column="create_time" property="createTime"/>
        <result column="update_user" property="updateUser"/>
        <result column="update_time" property="updateTime"/>
        <result column="is_deleted" property="isDeleted"/>
        <result column="media_status" property="mediaStatus"/>
        <result column="invite_id" property="inviteId"/>
        <result column="media_url" property="mediaUrl"/>
        <result column="media_type" property="mediaType"/>
        <result column="sort_no" property="sortNo"/>
    </resultMap>


    <select id="selectSportInviteMediaPage" resultMap="sportInviteMediaResultMap">
        select * from ldqc_sport_invite_media where is_deleted = 0
    </select>


    <select id="exportSportInviteMedia" resultType="org.springblade.modules.sportinvitemedia.excel.SportInviteMediaExcel">
        SELECT * FROM ldqc_sport_invite_media ${ew.customSqlSegment}
    </select>

</mapper>
