package org.springblade.modules.message.service.impl;

import com.baomidou.mybatisplus.core.conditions.query.QueryWrapper;
import org.springblade.common.constant.PlatformConstant;
import org.springblade.common.utils.RedisUtils;
import org.springblade.core.tool.jackson.JsonUtil;
import org.springblade.core.tool.utils.BeanUtil;
import org.springblade.modules.message.pojo.dto.BrowseRecordDTO;
import org.springblade.modules.message.pojo.entity.ImgDetailEntity;
import org.springblade.modules.message.pojo.vo.ImgDetailVO;
import org.springblade.modules.message.excel.ImgDetailExcel;
import org.springblade.modules.message.mapper.ImgDetailMapper;
import org.springblade.modules.message.service.IImgDetailService;
import org.springblade.modules.system.pojo.entity.User;
import org.springblade.modules.system.service.IUserService;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;
import com.baomidou.mybatisplus.core.conditions.Wrapper;
import com.baomidou.mybatisplus.core.metadata.IPage;
import org.springblade.core.mp.base.BaseServiceImpl;
import org.springframework.transaction.annotation.Transactional;

import java.util.*;
import java.util.stream.Collectors;

/**
 * 图片详情表 服务实现类
 *
 * @author BladeX
 * @since 2026-01-27
 */
@Service
public class ImgDetailServiceImpl extends BaseServiceImpl<ImgDetailMapper, ImgDetailEntity> implements IImgDetailService {



	@Autowired
	private RedisUtils redisUtils;

	@Autowired
	private IUserService userService;

	@Override
	public IPage<ImgDetailVO> selectImgDetailPage(IPage<ImgDetailVO> page, ImgDetailVO imgDetail) {
		return page.setRecords(baseMapper.selectImgDetailPage(page, imgDetail));
	}


	@Override
	public List<ImgDetailExcel> exportImgDetail(Wrapper<ImgDetailEntity> queryWrapper) {
		List<ImgDetailExcel> imgDetailList = baseMapper.exportImgDetail(queryWrapper);
		//imgDetailList.forEach(imgDetail -> {
		//	imgDetail.setTypeName(DictCache.getValue(DictEnum.YES_NO, ImgDetail.getType()));
		//});
		return imgDetailList;
	}


	@Override
	public IPage<ImgDetailVO> searchImgDetail(long page, long limit, String keyword, Integer type) {
		QueryWrapper<ImgDetailEntity> qw = new QueryWrapper<>();
		qw.eq("status", 1); // Only visible

		if (keyword != null && !keyword.trim().isEmpty()) {
			qw.like("content", keyword);
		}

		if (type != null) {
			if (type == 1) {
				qw.orderByDesc("agree_count");
			} else if (type == 2) {
				qw.orderByDesc("update_time");
			} else {
				qw.orderByDesc("update_time");
			}
		} else {
			qw.orderByDesc("update_time");
		}

		IPage<ImgDetailEntity> entityPage = this.page(new com.baomidou.mybatisplus.extension.plugins.pagination.Page<>(page, limit), qw);

		List<ImgDetailVO> voList = new ArrayList<>();
		if (entityPage.getRecords() != null && !entityPage.getRecords().isEmpty()) {
			List<Long> uids = entityPage.getRecords().stream().map(ImgDetailEntity::getUserId).collect(Collectors.toList());
			Map<Long, User> userMap = new HashMap<>();
			if (!uids.isEmpty()) {
				List<User> users = userService.listByIds(uids);
				users.forEach(u -> userMap.put(u.getId(), u));
			}

			for (ImgDetailEntity entity : entityPage.getRecords()) {
				ImgDetailVO vo = BeanUtil.copy(entity, ImgDetailVO.class);
				User user = userMap.get(entity.getUserId());
				if (user != null) {
					vo.setAvatar(user.getAvatar());
					vo.setUsername(user.getName());

				}
				voList.add(vo);
			}
		}

		IPage<ImgDetailVO> resultPage = new com.baomidou.mybatisplus.extension.plugins.pagination.Page<>(page, limit);
		resultPage.setRecords(voList);
		resultPage.setTotal(entityPage.getTotal());
		return resultPage;
	}



	@Override
	public IPage<ImgDetailVO> getPage(IPage<ImgDetailVO> page) {
		IPage<ImgDetailEntity> entityPage = this.page(new com.baomidou.mybatisplus.extension.plugins.pagination.Page<>(page.getCurrent(), page.getSize()),
			new QueryWrapper<ImgDetailEntity>().orderByDesc("create_time"));
		return convertToVoPage(entityPage, page);
	}

	@Override
	public IPage<ImgDetailVO> getAllImgByAlbum(IPage<ImgDetailVO> page, String albumId, Integer type) {
		// 注意：原逻辑需要关联查询相册图片关系表，这里简化为直接查询（假设有中间表服务，后续需补充）
		// 由于缺少 AlbumImgRelationService，暂时只返回空或基础查询
		// TODO: 补充 AlbumImgRelationService 逻辑
		return page;
	}

	@Override
	public ImgDetailVO getImgDetail(String id) {
		ImgDetailEntity entity = this.getById(id);
		return convertToVo(entity);
	}

	@Override
	@Transactional(rollbackFor = Exception.class)
	public Long publish(ImgDetailEntity imgDetail) {
		this.save(imgDetail);
		// 模拟 ES 存储和 MQ 发送
		// esClient.addImgDetail(imgDetail);
		// sendMessageMq.send(imgDetail);
		return imgDetail.getId();
	}

	@Override
	@Transactional(rollbackFor = Exception.class)
	public void deleteImgs(List<String> idList, String uid) {
		// 删除逻辑
		this.removeByIds(idList);
		// 清除 Redis 缓存
		idList.forEach(id -> redisUtils.delete(PlatformConstant.IMG_DETAIL_STATE + id));
	}

	@Override
	public IPage<ImgDetailVO> getHot(IPage<ImgDetailVO> page) {
		IPage<ImgDetailEntity> entityPage = this.page(new com.baomidou.mybatisplus.extension.plugins.pagination.Page<>(page.getCurrent(), page.getSize()),
			new QueryWrapper<ImgDetailEntity>().orderByDesc("agree_count").orderByDesc("create_time"));
		return convertToVoPage(entityPage, page);
	}

	@Override
	public List<ImgDetailVO> getAllBrowseRecordByUser(long page, long limit, String uid) {
		List<ImgDetailVO> imgDetailVoList = new ArrayList<>();
		String userBrowseRecordKey = PlatformConstant.BR_IMG_KEY + uid;
		if (Boolean.TRUE.equals(redisUtils.hasKey(userBrowseRecordKey))) {
			List<String> strings = redisUtils.lRange(userBrowseRecordKey, (page - 1) * limit, page * limit);
			if (strings != null) {
				for (String e : strings) {
					imgDetailVoList.add(JsonUtil.parse(e, ImgDetailVO.class));
				}
			}
		}
		return imgDetailVoList;
	}

	@Override
	public void addBrowseRecord(BrowseRecordDTO browseRecordDTO) {
		String userBrowseRecordKey = PlatformConstant.BR_IMG_KEY + browseRecordDTO.getUid();
		if (Boolean.TRUE.equals(redisUtils.hasKey(userBrowseRecordKey))) {
			List<String> objs = redisUtils.lRange(userBrowseRecordKey, 0, -1);
			if (objs != null) {
				for (String s : objs) {
					ImgDetailVO imgDetailVo = JsonUtil.parse(s, ImgDetailVO.class);
					if (imgDetailVo != null && imgDetailVo.getId().equals(browseRecordDTO.getMid())) {
						redisUtils.lRemove(userBrowseRecordKey, 0, s);
						break;
					}
				}
			}
		}

		ImgDetailEntity imgDetail = this.getById(browseRecordDTO.getMid());
		if (imgDetail != null) {
			ImgDetailVO imgDetailVo = convertToVo(imgDetail);
			redisUtils.lLeftPush(userBrowseRecordKey, JsonUtil.toJson(imgDetailVo));
		}
	}

	@Override
	public void delRecord(String uid, List<String> idList) {
		String userBrowseRecordKey = PlatformConstant.BR_IMG_KEY + uid;
		if (Boolean.TRUE.equals(redisUtils.hasKey(userBrowseRecordKey))) {
			List<String> objs = redisUtils.lRange(userBrowseRecordKey, 0, -1);
			if (objs != null) {
				for (String mid : idList) {
					for (String s : objs) {
						ImgDetailVO imgDetailVo = JsonUtil.parse(s, ImgDetailVO.class);
						if (imgDetailVo != null && imgDetailVo.getId().toString().equals(mid)) {
							redisUtils.lRemove(userBrowseRecordKey, 0, s);
							break;
						}
					}
				}
			}
		}
	}

	@Override
	public void updateCommentCount(String id, int count) {
		ImgDetailEntity entity = this.getById(id);
		if (entity != null) {
			entity.setCommentCount(entity.getCommentCount() + count);
			this.updateById(entity);
		}
	}

	@Override
	public void updateAgreeCount(String id, int count) {
		ImgDetailEntity entity = this.getById(id);
		if (entity != null) {
			entity.setAgreeCount(entity.getAgreeCount() + count);
			this.updateById(entity);
		}
	}

	@Override
	public void updateCollectCount(String id, int count) {
		ImgDetailEntity entity = this.getById(id);
		if (entity != null) {
			entity.setCollectionCount(entity.getCollectionCount() + count);
			this.updateById(entity);
		}
	}

	// 辅助方法：Entity 转 VO 并填充用户信息
	private ImgDetailVO convertToVo(ImgDetailEntity entity) {
		if (entity == null) return null;
		ImgDetailVO vo = BeanUtil.copy(entity, ImgDetailVO.class);
		User user = userService.getById(entity.getUserId());
		if (user != null) {
			vo.setUsername(user.getName()); // BladeX User 使用 name
			vo.setAvatar(user.getAvatar());
		}
		return vo;
	}

	private IPage<ImgDetailVO> convertToVoPage(IPage<ImgDetailEntity> entityPage, IPage<ImgDetailVO> voPage) {
		List<ImgDetailEntity> records = entityPage.getRecords();
		List<ImgDetailVO> voList = new ArrayList<>();
		if (records != null && !records.isEmpty()) {
			Set<Long> uids = records.stream().map(ImgDetailEntity::getUserId).collect(Collectors.toSet());
			List<User> userList = userService.listByIds(uids);
			Map<Long, User> userMap = userList.stream().collect(Collectors.toMap(User::getId, u -> u));

			for (ImgDetailEntity entity : records) {
				ImgDetailVO vo = BeanUtil.copy(entity, ImgDetailVO.class);
				User user = userMap.get(entity.getUserId());
				if (user != null) {
					vo.setUsername(user.getName());
					vo.setAvatar(user.getAvatar());
				}
				voList.add(vo);
			}
		}
		return voPage.setRecords(voList).setTotal(entityPage.getTotal());
	}

}
