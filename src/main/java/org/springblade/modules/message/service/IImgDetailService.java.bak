package org.springblade.modules.message.service;

import com.baomidou.mybatisplus.core.conditions.Wrapper;
import org.springblade.modules.message.pojo.entity.ImgDetailEntity;
import org.springblade.modules.message.pojo.vo.ImgDetailVO;
import org.springblade.modules.message.excel.ImgDetailExcel;
import com.baomidou.mybatisplus.core.metadata.IPage;
import org.springblade.core.mp.base.BaseService;
import java.util.List;

/**
 * 图片详情表 服务类
 *
 * @author BladeX
 * @since 2026-01-27
 */
public interface IImgDetailService extends BaseService<ImgDetailEntity> {
	/**
	 * 自定义分页
	 *
	 * @param page 分页参数
	 * @param imgDetail 查询参数
	 * @return IPage<ImgDetailVO>
	 */
	IPage<ImgDetailVO> selectImgDetailPage(IPage<ImgDetailVO> page, ImgDetailVO imgDetail);


	/**
	 * 导出数据
	 *
	 * @param queryWrapper 查询条件
	 * @return List<ImgDetailExcel>
	 */
	List<ImgDetailExcel> exportImgDetail(Wrapper<ImgDetailEntity> queryWrapper);




	/**
	 * 搜索图片详情 (DB Fallback for ES)
	 *
	 * @param page
	 * @param limit
	 * @param keyword
	 * @param type 0:All, 1:AgreeCount, 2:Time
	 * @return
	 */
	IPage<ImgDetailVO> searchImgDetail(long page, long limit, String keyword, Integer type);

	/**
	 * 分页获取所有的图片信息
	 */
	IPage<ImgDetailVO> getPage(IPage<ImgDetailVO> page);

	/**
	 * 根据专辑id删除图片
	 */
	IPage<ImgDetailVO> getAllImgByAlbum(IPage<ImgDetailVO> page, String albumId, Integer type);

	/**
	 * 得到当前图片信息
	 */
	ImgDetailVO getImgDetail(String id);

	/**
	 * 发布图片信息
	 */
	Long publish(ImgDetailEntity imgDetail);

	/**
	 * 根据id删除当前用户上传到图片
	 */
	void deleteImgs(List<String> idList, String uid);

	/**
	 * 获取热榜数据
	 */
	IPage<ImgDetailVO> getHot(IPage<ImgDetailVO> page);

	/**
	 * 获取用户浏览记录
	 */
	List<ImgDetailVO> getAllBrowseRecordByUser(long page, long limit, String uid);

	/**
	 * 添加浏览记录
	 */
	void addBrowseRecord(org.springblade.modules.message.pojo.dto.BrowseRecordDTO browseRecordDTO);

	/**
	 * 删除浏览记录
	 */
	void delRecord(String uid, List<String> idList);

	/**
	 * 更新评论数
	 * @param id 图片ID
	 * @param count 变化量 (+1 或 -1)
	 */
	void updateCommentCount(String id, int count);

	/**
	 * 更新点赞数
	 * @param id 图片ID
	 * @param count 变化量
	 */
	void updateAgreeCount(String id, int count);

	/**
	 * 更新收藏数
	 * @param id 图片ID
	 * @param count 变化量
	 */
	void updateCollectCount(String id, int count);

}
