<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.springblade.modules.album.mapper.AlbumMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="albumResultMap" type="org.springblade.modules.album.pojo.entity.AlbumEntity">
        <result column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="name" property="name"/>
        <result column="uid" property="uid"/>
        <result column="cover" property="cover"/>
        <result column="sort" property="sort"/>
        <result column="img_count" property="imgCount"/>
        <result column="collection_count" property="collectionCount"/>
        <result column="create_user" property="createUser"/>
        <result column="create_dept" property="createDept"/>
        <result column="create_time" property="createTime"/>
        <result column="update_user" property="updateUser"/>
        <result column="update_time" property="updateTime"/>
        <result column="status" property="status"/>
        <result column="is_deleted" property="isDeleted"/>
    </resultMap>


    <select id="selectAlbumPage" resultMap="albumResultMap">
        select * from t_album where is_deleted = 0
    </select>


    <select id="exportAlbum" resultType="org.springblade.modules.album.excel.AlbumExcel">
        SELECT * FROM t_album ${ew.customSqlSegment}
    </select>

</mapper>
