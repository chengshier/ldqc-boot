<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.springblade.modules.bannerposition.mapper.BannerPositionMapper">
    <resultMap id="bannerPositionResultMap" type="org.springblade.modules.bannerposition.pojo.entity.BannerPositionEntity">
        <result column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="code" property="code"/>
        <result column="name" property="name"/>
        <result column="terminal" property="terminal"/>
        <result column="page_code" property="pageCode"/>
        <result column="channel_code" property="channelCode"/>
        <result column="display_style" property="displayStyle"/>
        <result column="max_items" property="maxItems"/>
        <result column="status" property="status"/>
        <result column="sort" property="sort"/>
        <result column="remark" property="remark"/>
        <result column="create_user" property="createUser"/>
        <result column="create_dept" property="createDept"/>
        <result column="create_time" property="createTime"/>
        <result column="update_user" property="updateUser"/>
        <result column="update_time" property="updateTime"/>
        <result column="is_deleted" property="isDeleted"/>
    </resultMap>

    <select id="selectBannerPositionPage" resultType="org.springblade.modules.bannerposition.pojo.vo.BannerPositionVO">
        SELECT bp.id,
               bp.tenant_id AS tenantId,
               bp.code,
               bp.name,
               bp.terminal,
               bp.page_code AS pageCode,
               bp.channel_code AS channelCode,
               bp.display_style AS displayStyle,
               bp.max_items AS maxItems,
               bp.status,
               bp.sort,
               bp.remark,
               bp.create_user AS createUser,
               bp.create_dept AS createDept,
               bp.create_time AS createTime,
               bp.update_user AS updateUser,
               bp.update_time AS updateTime,
               bp.is_deleted AS isDeleted,
               COUNT(bi.id) AS itemCount
        FROM ldqc_banner_position bp
        LEFT JOIN ldqc_banner_item bi ON bi.position_id = bp.id AND bi.is_deleted = 0
        WHERE bp.is_deleted = 0
        <if test="bannerPosition != null">
            <if test="bannerPosition.code != null and bannerPosition.code != ''">
                AND bp.code LIKE CONCAT('%', #{bannerPosition.code}, '%')
            </if>
            <if test="bannerPosition.name != null and bannerPosition.name != ''">
                AND bp.name LIKE CONCAT('%', #{bannerPosition.name}, '%')
            </if>
            <if test="bannerPosition.terminal != null and bannerPosition.terminal != ''">
                AND bp.terminal = #{bannerPosition.terminal}
            </if>
            <if test="bannerPosition.pageCode != null and bannerPosition.pageCode != ''">
                AND bp.page_code LIKE CONCAT('%', #{bannerPosition.pageCode}, '%')
            </if>
            <if test="bannerPosition.channelCode != null and bannerPosition.channelCode != ''">
                AND bp.channel_code = #{bannerPosition.channelCode}
            </if>
            <if test="bannerPosition.displayStyle != null and bannerPosition.displayStyle != ''">
                AND bp.display_style = #{bannerPosition.displayStyle}
            </if>
            <if test="bannerPosition.status != null">
                AND bp.status = #{bannerPosition.status}
            </if>
        </if>
        GROUP BY bp.id, bp.tenant_id, bp.code, bp.name, bp.terminal, bp.page_code, bp.channel_code, bp.display_style,
                 bp.max_items, bp.status, bp.sort, bp.remark, bp.create_user, bp.create_dept, bp.create_time,
                 bp.update_user, bp.update_time, bp.is_deleted
        ORDER BY bp.sort ASC, bp.create_time DESC
    </select>

    <select id="exportBannerPosition" resultType="org.springblade.modules.bannerposition.excel.BannerPositionExcel">
        SELECT * FROM ldqc_banner_position ${ew.customSqlSegment}
    </select>
</mapper>
