<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.springblade.modules.outdoor.mapper.OutdoorMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="outdoorResultMap" type="org.springblade.modules.outdoor.pojo.entity.OutdoorEntity">
        <result column="id" property="id"/>
        <result column="title" property="title"/>
        <result column="cover_image" property="coverImage"/>
        <result column="end_time" property="endTime"/>
        <result column="location" property="location"/>
        <result column="address" property="address"/>
        <result column="longitude" property="longitude"/>
        <result column="latitude" property="latitude"/>
        <result column="difficulty" property="difficulty"/>
        <result column="organizer_id" property="organizerId"/>
        <result column="likes_count" property="likesCount"/>
        <result column="description" property="description"/>
        <result column="rating" property="rating"/>
        <result column="comment_count" property="commentCount"/>
        <result column="price" property="price"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="create_user" property="createUser"/>
        <result column="create_dept" property="createDept"/>
        <result column="create_time" property="createTime"/>
        <result column="update_user" property="updateUser"/>
        <result column="update_time" property="updateTime"/>
        <result column="is_deleted" property="isDeleted"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="status" property="status"/>
    </resultMap>


    <select id="selectOutdoorPage" resultMap="outdoorResultMap">
        select * from ldqc_outdoor where is_deleted = 0
    </select>


    <select id="exportOutdoor" resultType="org.springblade.modules.outdoor.excel.OutdoorExcel">
        SELECT * FROM ldqc_outdoor ${ew.customSqlSegment}
    </select>

</mapper>
