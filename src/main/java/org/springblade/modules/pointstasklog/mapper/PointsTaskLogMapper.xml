<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.springblade.modules.pointstasklog.mapper.PointsTaskLogMapper">

    <select id="selectPointsTaskLogPage" resultType="org.springblade.modules.pointstasklog.pojo.vo.PointsTaskLogVO">
        select * from points_task_log where is_deleted = 0
    </select>

    <select id="exportPointsTaskLog" resultType="org.springblade.modules.pointstasklog.excel.PointsTaskLogExcel">
        select * from points_task_log
    </select>

</mapper>
