<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.springblade.modules.sportinviteapply.mapper.SportInviteApplyMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="sportInviteApplyResultMap" type="org.springblade.modules.sportinviteapply.pojo.entity.SportInviteApplyEntity">
        <result column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="status" property="status"/>
        <result column="create_user" property="createUser"/>
        <result column="create_dept" property="createDept"/>
        <result column="create_time" property="createTime"/>
        <result column="update_user" property="updateUser"/>
        <result column="update_time" property="updateTime"/>
        <result column="is_deleted" property="isDeleted"/>
        <result column="apply_status" property="applyStatus"/>
        <result column="invite_id" property="inviteId"/>
        <result column="applicant_user_id" property="applicantUserId"/>
        <result column="applicant_level" property="applicantLevel"/>
        <result column="sport_experience" property="sportExperience"/>
        <result column="punctual_confirm" property="punctualConfirm"/>
        <result column="contact_phone" property="contactPhone"/>
        <result column="contact_wechat" property="contactWechat"/>
        <result column="apply_message" property="applyMessage"/>
        <result column="apply_images" property="applyImages"/>
        <result column="audit_user_id" property="auditUserId"/>
        <result column="audit_time" property="auditTime"/>
        <result column="reject_reason" property="rejectReason"/>
    </resultMap>


    <select id="selectSportInviteApplyPage" resultMap="sportInviteApplyResultMap">
        select * from ldqc_sport_invite_apply where is_deleted = 0
    </select>


    <select id="exportSportInviteApply" resultType="org.springblade.modules.sportinviteapply.excel.SportInviteApplyExcel">
        SELECT * FROM ldqc_sport_invite_apply ${ew.customSqlSegment}
    </select>

</mapper>
