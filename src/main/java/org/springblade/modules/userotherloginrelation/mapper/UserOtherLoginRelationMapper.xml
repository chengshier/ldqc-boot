<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.springblade.modules.userotherloginrelation.mapper.UserOtherLoginRelationMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="userOtherLoginRelationResultMap" type="org.springblade.modules.userotherloginrelation.pojo.entity.UserOtherLoginRelationEntity">
        <result column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="uid" property="uid"/>
        <result column="other_user_id" property="otherUserId"/>
        <result column="other_username" property="otherUsername"/>
        <result column="other_avatar" property="otherAvatar"/>
        <result column="other_token" property="otherToken"/>
        <result column="create_user" property="createUser"/>
        <result column="create_dept" property="createDept"/>
        <result column="create_time" property="createTime"/>
        <result column="update_user" property="updateUser"/>
        <result column="update_time" property="updateTime"/>
        <result column="status" property="status"/>
        <result column="is_deleted" property="isDeleted"/>
    </resultMap>


    <select id="selectUserOtherLoginRelationPage" resultMap="userOtherLoginRelationResultMap">
        select * from t_user_other_login_relation where is_deleted = 0
    </select>


    <select id="exportUserOtherLoginRelation" resultType="org.springblade.modules.userotherloginrelation.excel.UserOtherLoginRelationExcel">
        SELECT * FROM t_user_other_login_relation ${ew.customSqlSegment}
    </select>

</mapper>
